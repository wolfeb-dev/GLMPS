{
  "name": "glmps",
  "version": "2.0.0",
  "private": true,
  "description": "Local dashboard showing live, per-session what every Claude Code / CLI agent session is doing: skills, agents, memory, CLAUDE.md, git, file edits.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node server/server.js",
    "setup": "node scripts/install.mjs",
    "dashboard-link": "node scripts/dashboard-link.mjs",
    "test": "node --test --env-file=test.env --test-concurrency=4 \"**/*.test.js\"",
    "service:install": "node scripts/service/install-service.mjs",
    "service:uninstall": "node scripts/service/uninstall-service.mjs",
    "service:status": "node scripts/service/status.mjs"
  }
}
